<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/window_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Security &amp; Preferences"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Customize encryption parameters, master PIN and phone credential permissions"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Master PIN & Phone Lock Isolation Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TrustCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vault Master PIN &amp; Device Isolation"
                    android:textColor="@color/accent_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Protect the vault with an independent PIN. By default, your general phone screen password cannot open Trust Vault."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Disallow Phone Password Toggle -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_allow_phone_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:checked="false"
                    android:text="Allow Phone Screen Password/Pattern to unlock"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Turned OFF by default to ensure no phone lock works on Trust Vault without your permission."
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />

                <!-- Change Master PIN Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_master_pin"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="Set / Change Master Vault PIN"
                    android:textColor="@color/white"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_key"
                    app:iconTint="@color/accent_cyan" />

                <!-- Remove Master PIN Button (Visible when PIN exists) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_remove_master_pin"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:text="Remove Master PIN (Disable Lock)"
                    android:textColor="@color/status_danger"
                    android:visibility="gone"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/status_danger" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Security Configuration Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TrustCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lock On Opening &amp; Biometrics"
                    android:textColor="@color/accent_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Lock On Start/Opening Switch -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_lock_on_start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:checked="false"
                    android:text="Require Lock when Opening App"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Turn OFF to open app directly without asking for PIN/Biometric at start."
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />

                <!-- Biometric Switch -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_biometric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:checked="false"
                    android:text="Biometric Sensor (Fingerprint / Face)"
                    android:textColor="@color/text_primary" />

                <!-- Auto-Lock Switch -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_auto_lock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="false"
                    android:text="Lock App on Exit / Background"
                    android:textColor="@color/text_primary" />

                <!-- Lock Now Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lock_vault_now"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/lock_now_btn"
                    android:textColor="@color/accent_blue_light"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_lock"
                    app:iconTint="@color/accent_blue_light" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Theme & Appearance Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TrustCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appearance"
                    android:textColor="@color/accent_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_dark_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:checked="true"
                    android:text="Dark Navy Theme"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cryptographic Specs Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TrustCard.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Encryption &amp; Privacy Specifications"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="• Algorithm: AES/GCM/NoPadding (256-bit)\n• Key Storage: Android Hardware Keystore (TEE / StrongBox)\n• Device Credential Blocking: Enabled (Active)\n• Document Storage: Encrypted App Sandboxed Storage\n• Screen Capture: Blocked via FLAG_SECURE"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
